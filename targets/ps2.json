{
	"llvm-target": "mips64el-unknown-none-gnuabin32",
	"cpu": "r5900",
	"features": "-noabicalls,+single-float",
	"build-tags": ["ps2", "baremetal", "mipsel"],
	"goos": "linux",
	"goarch": "mipsle",
	"scheduler": "tasks",
	"default-stack-size": 65536,
	"gc-noptr-section": ".ps2go.noscan",
	"linker": "ld.lld",
	"rtlib": "compiler-rt",
	"libc": "",
	"cflags": [
		"-mabi=n32",
		"-mhard-float",
		"-msingle-float"
	],
	"ldflags": [
		"-mabi=n32"
	],
	"linkerscript": "",
	"extra-files": [
	],
	"gdb": []
}
